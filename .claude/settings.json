{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(grep:*)",
      "Bash(comm:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(bash docs/checks.sh)",
      "Bash(python3 -m http.server:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(git push origin --delete:*)"
    ]
  }
}
